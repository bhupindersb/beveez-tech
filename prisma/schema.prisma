// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  starter
  growth
  performance
  custom
}

model Lead {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  name        String
  email       String
  company     String?
  goals       String?
  details     String?

  plan        PlanType

  ipAddress   String?
  userAgent   String?

  status      String   @default("new") // new | contacted | closed

  @@index([email])
  @@index([plan])
}
